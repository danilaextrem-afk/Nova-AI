# Copy to .env and fill in. NEVER commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://nova:change-me@localhost:5432/nova
JWT_SECRET=generate-with-openssl-rand-hex-32

# Google Play Billing (server-side verification). Owner must provide.
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_JSON=

# AdMob rewarded ads + SSV. Use Google's test ad unit while developing.
ADMOB_REWARDED_AD_UNIT=
ADMOB_REWARD_AMOUNT=5
ADMOB_DAILY_LIMIT=10
ADMOB_MIN_INTERVAL_SEC=60

# AI provider: openrouter (default), groq, gemini. Server-only secrets.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# App free-chat rate limit, shared across users' characters. Defaults to 10/day.
# No app-side daily message cap for free tier. Provider quotas and abuse rate limits apply.
# Premium uses a distinct higher-quality model; never set it to the free model.
NOVA_PREMIUM_PROVIDER=groq
NOVA_PREMIUM_MODEL=
NOVA_PREMIUM_TOKENS_PER_MESSAGE=5
